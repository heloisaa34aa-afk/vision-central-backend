{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://vison-central-nu.vercel.app",
          "http://localhost:5173"
        ],
        "methods": ["GET", "HEAD", "PUT"],
        "headers": ["Content-Type"]
      },
      "exposeHeaders": ["ETag", "Content-Length"],
      "maxAgeSeconds": 3600
    }
  ]
}
